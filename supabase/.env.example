# Copy only the needed provider variables into Supabase Edge Function Secrets.
# Do not put real API keys in this file or in Flutter.

# AI text-analysis providers
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
SAMBANOVA_API_KEY=
COHERE_API_KEY=
NVIDIA_API_KEY=
ZAI_API_KEY=
HF_TOKEN=

# Providers are called only when explicitly selected here, with a key and model.
# The first ID is primary; at most one second ID is used as fallback.
AI_PROVIDER_ORDER=
AI_FALLBACK_ENABLED=

# Model IDs must be selected from the provider's current model catalog.
GEMINI_MODEL=
GROQ_MODEL=
OPENROUTER_MODEL=
MISTRAL_MODEL=
CLOUDFLARE_MODEL=
SAMBANOVA_MODEL=
COHERE_MODEL=
NVIDIA_MODEL=
ZAI_MODEL=
HUGGINGFACE_MODEL=

# Set per-provider flags to false to disable a selected provider.
AI_PROVIDER_GEMINI_ENABLED=
AI_PROVIDER_GROQ_ENABLED=
AI_PROVIDER_OPENROUTER_ENABLED=
AI_PROVIDER_CLOUDFLARE_ENABLED=
AI_PROVIDER_SAMBANOVA_ENABLED=
AI_PROVIDER_COHERE_ENABLED=
AI_PROVIDER_NVIDIA_ENABLED=
AI_PROVIDER_HUGGINGFACE_ENABLED=

# URL intelligence. OpenPhish uses a public community feed and needs no key.
URLHAUS_AUTH_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
OTX_API_KEY=
PHISHTANK_API_KEY=
URLSCAN_API_KEY=
THREATFOX_AUTH_KEY=
VIRUSTOTAL_API_KEY=
PULSEDIVE_API_KEY=

# Supabase supplies SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY to Edge Functions.
# Keep the service-role key server-side; never add it to Flutter or this template.
# Flutter uses SUPABASE_URL and SUPABASE_ANON_KEY via its existing build config.
